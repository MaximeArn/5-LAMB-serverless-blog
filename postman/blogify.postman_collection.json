            "url": {
              "raw": "{{baseUrl}}/manage/posts/{{postId}}/status",
              "host": ["{{baseUrl}}"],
              "path": ["manage", "posts", "{{postId}}", "status"]
            },
            "description": "Réservé aux rôles `editor` et `admin`. L'article disparaît de la lecture publique.\n\nErreurs : `403 FORBIDDEN`, `404 POST_NOT_FOUND`, `409 POST_CONFLICT`."
          },
          "response": []
