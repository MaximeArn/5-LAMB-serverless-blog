            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/manage/posts/{{postId}}",
              "host": ["{{baseUrl}}"],
              "path": ["manage", "posts", "{{postId}}"]
            },
            "description": "Supprime définitivement l'article.\n\nErreurs : `403 FORBIDDEN`, `404 POST_NOT_FOUND`."
          },
          "response": []
        }
      ]
