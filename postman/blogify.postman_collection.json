    {
      "name": "Médias",
      "description": "Le fichier ne passe pas par l'API : elle délivre un formulaire signé, puis le client envoie le fichier directement à S3. Images (JPEG, PNG, WebP, GIF) jusqu'à 10 Mo, vidéos (MP4, WebM) jusqu'à 100 Mo.",
      "item": [
        {
          "name": "Demander une URL d'envoi",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', () => pm.response.to.have.status(201));",
                  "",
                  "const body = pm.response.json();",
                  "pm.test('formulaire S3 fourni', () => pm.expect(body.upload.fields).to.have.property('Policy'));",
                  "",
                  "// Stores the S3 form fields for « Envoyer le fichier sur S3 »",
                  "if (body.mediaId) {",
                  "  pm.collectionVariables.set('mediaId', body.mediaId);",
                  "  pm.collectionVariables.set('mediaOwnerId', body.ownerId);",
                  "  pm.collectionVariables.set('uploadUrl', body.upload.url);",
                  "  for (const [name, value] of Object.entries(body.upload.fields)) {",
                  "    pm.collectionVariables.set('upload_' + name.replace(/[^A-Za-z0-9]/g, '_'), value);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fileName\": \"photo.jpg\",\n  \"contentType\": \"image/jpeg\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/manage/media",
              "host": ["{{baseUrl}}"],
              "path": ["manage", "media"]
            },
